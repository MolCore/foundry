Bootstrap: docker
From: nvidia/cuda:12.1.0-devel-ubuntu22.04

%environment
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/usr/local/cuda/bin:/opt/rfd3/bin:$PATH
    export VIRTUAL_ENV=/opt/rfd3

    # Database paths - will be overridden by bind mounts at runtime
    export CCD_MIRROR_PATH=/runtime/databases/foundry/ccd
    export PDB_MIRROR_PATH=/runtime/databases/foundry/pdb

    # Foundry checkpoint directory
    export FOUNDRY_CHECKPOINT_DIRS=/root/.foundry/checkpoints

    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    # Update and install minimal system dependencies including Python 3.12
    apt-get update && apt-get upgrade -y
    apt-get install -y \
        wget \
        curl \
        git \
        build-essential \
        software-properties-common \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        python3-pip \
        libffi-dev \
        libssl-dev \
        zlib1g-dev \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libgomp1 \
        ca-certificates

    # Clean up apt cache to reduce image size
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Create Python virtual environment with Python 3.12
    python3.12 -m venv /opt/rfd3

    # Activate virtual environment
    . /opt/rfd3/bin/activate

    # Upgrade pip
    pip install --no-cache-dir --upgrade pip setuptools wheel

    # Install PyTorch with CUDA 12.1 support (MINIMAL - only torch)
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

    # Install foundry with RFD3 - let it pull minimal dependencies
    pip install --no-cache-dir rc-foundry[rfd3]

    # Download RFD3 checkpoint to container (one-time ~500MB download)
    foundry install rfd3 --checkpoint-dir /root/.foundry/checkpoints

    # Create working directories for bind mounts
    mkdir -p /workspace/inputs
    mkdir -p /workspace/outputs
    mkdir -p /workspace/configs
    mkdir -p /runtime/databases/foundry/ccd
    mkdir -p /runtime/databases/foundry/pdb

%runscript
    #!/bin/bash
    . /opt/rfd3/bin/activate
    exec "$@"

%labels
    Author="molCore - Protein Design Intelligence"
    Version="1.0.1"
    Description="RFDiffusion3 minimal container for all-atom protein design"
    Model="RFD3"
    CUDA="12.1"
    Python="3.12"
    Method="venv"

%help
    RFDiffusion3 (RFD3) Apptainer Container
    ========================================

    Minimal container for all-atom biomolecular design with RFD3.
    Uses Python 3.12 venv (no Conda) for simplicity.

    Usage:
    ------
    # Run RFD3 inference
    apptainer exec --nv \
        --bind /runtime/databases/foundry:/runtime/databases/foundry:ro \
        --bind /path/to/configs:/workspace/configs:ro \
        --bind /path/to/inputs:/workspace/inputs:ro \
        --bind /path/to/outputs:/workspace/outputs \
        --env PDB_MIRROR_PATH=/runtime/databases/foundry/pdb \
        --env CCD_MIRROR_PATH=/runtime/databases/foundry/ccd \
        rfd3.sif \
        rfd3 design \
            out_dir=/workspace/outputs \
            inputs=/workspace/configs/test.json \
            n_batches=1 \
            diffusion_batch_size=8

    Required bind mounts:
    ---------------------
    - /runtime/databases/foundry/pdb  : PDB mirror (read-only)
    - /runtime/databases/foundry/ccd  : CCD mirror (read-only)
    - /workspace/configs              : Input JSON specifications
    - /workspace/inputs               : Input PDB files (if referenced in JSON)
    - /workspace/outputs              : Output directory for generated structures

    Environment variables:
    ----------------------
    - PDB_MIRROR_PATH : Path to PDB database mirror
    - CCD_MIRROR_PATH : Path to CCD database mirror
    - CUDA_VISIBLE_DEVICES : GPU selection (default: 0)

    RFD3 checkpoint:
    ----------------
    Pre-downloaded in container at: /root/.foundry/checkpoints/rfd3_latest.ckpt

    GPU requirement:
    ----------------
    - Use --nv flag to enable NVIDIA GPU support
    - Requires >16GB GPU memory for typical designs
    - Recommended: L40S (48GB), H200 (141GB), or similar
